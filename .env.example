NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=          # server only, never in client code
NEXT_PUBLIC_MAP_STYLE_URL=          # optional: empty = OpenFreeMap (free, no key)
ADMIN_TOKEN=                        # long random string
IP_HASH_SALT=                       # long random string
NEXT_PUBLIC_TURNSTILE_SITE_KEY=     # optional
TURNSTILE_SECRET_KEY=               # optional
NEXT_PUBLIC_CONTACT_URL=            # optional: mailto: or https:// link shown in the footer and privacy page
NEXT_PUBLIC_SITE_URL=               # optional: public site URL for link previews (default https://spbu-watch.vercel.app)
